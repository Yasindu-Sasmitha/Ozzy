+  // ===== Stage 9: reminders, toasts and speaking first =====
+  const REMINDER_POLL_MS = 5000;
+  const WAKE_MAX_MS = 90000;
+  const WAKE_FALLBACK_MS = 30000;
+  const shownReminderEvents = new Set();
+  let reminderSettings = { speak_first: true, notifications: true };
+  let wakeSession = false;
+  let wakeSpoke = false;
+  let wakeStartedAt = 0;
+  let wakeCooldownUntil = 0;
+  let wakeCloseTimer = null;
+  let reminderPollBusy = false;
+
+  async function reminderApi(path, body) {
+    const response = await fetch(path, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json', 'X-Ozzy-Request': '1' },
+      body: JSON.stringify(body || {})
+    });
+    return response.json();
+  }
+
+  function playChime() {
+    try {
+      const context = new AudioContext();
+      const oscillator = context.createOscillator();
+      const gain = context.createGain();
+      oscillator.type = 'sine';
+      oscillator.frequency.setValueAtTime(880, context.currentTime);
+      oscillator.frequency.setValueAtTime(1175, context.currentTime + 0.14);
+      gain.gain.setValueAtTime(0.0001, context.currentTime);
+      gain.gain.exponentialRampToValueAtTime(0.15, context.currentTime + 0.03);
+      gain.gain.exponentialRampToValueAtTime(0.0001, context.currentTime + 0.5);
+      oscillator.connect(gain);
+      gain.connect(context.destination);
+      oscillator.start();
+      oscillator.stop(context.currentTime + 0.55);
+      oscillator.onended = () => { try { context.close(); } catch (_) {} };
+    } catch (_) {}
+  }
+
+  function reminderLabel(event) {
+    return (event.kind === 'timer' ? '⏲️ Timer' : '⏰ Reminder') + (event.late ? ' (missed)' : '');
+  }
+
+  function removeToast(toast) {
+    if (toast && toast.parentNode) toast.parentNode.removeChild(toast);
+  }
+
+  function showReminderToast(event) {
+    if (!event || shownReminderEvents.has(event.id)) return;
+    shownReminderEvents.add(event.id);
+    const toast = document.createElement('div');
+    toast.className = 'toast';
+    toast.setAttribute('role', 'alert');
+    const title = document.createElement('div');
+    title.className = 'toast-title';
+    title.textContent = reminderLabel(event) + ': ' + String(event.title || '');
+    toast.appendChild(title);
+    if (event.note) {
+      const body = document.createElement('div');
+      body.className = 'toast-body';
+      body.textContent = String(event.note);
+      toast.appendChild(body);
+    }
+    const meta = document.createElement('div');
+    meta.className = 'toast-meta';
+    meta.textContent = 'Due ' + String(event.due_local || '');
+    toast.appendChild(meta);
+    const actions = document.createElement('div');
+    actions.className = 'toast-actions';
+    const snoozeButton = document.createElement('button');
+    snoozeButton.textContent = 'Snooze 10 min';
+    snoozeButton.addEventListener('click', async () => {
+      try { await reminderApi('/api/reminders/events/' + event.id + '/snooze', { minutes: 10 }); } catch (_) {}
+      removeToast(toast);
+      if (!remindersPanel.hidden) loadReminders();
+    });
+    const dismissButton = document.createElement('button');
+    dismissButton.textContent = 'Dismiss';
+    dismissButton.addEventListener('click', async () => {
+      try { await reminderApi('/api/reminders/events/' + event.id + '/dismiss'); } catch (_) {}
+      removeToast(toast);
+    });
+    actions.append(snoozeButton, dismissButton);
+    toast.appendChild(actions);
+    toastStack.appendChild(toast);
+    while (toastStack.children.length > 5) removeToast(toastStack.firstChild);
+    reminderApi('/api/reminders/events/' + event.id + '/shown').catch(() => {});
+
+    if (reminderSettings.notifications) {
+      const text = String(event.note || event.due_local || '');
+      const heading = reminderLabel(event) + ': ' + String(event.title || '');
+      try {
+        if (window.ozzyDesktop && typeof window.ozzyDesktop.notify === 'function') {
+          window.ozzyDesktop.notify({ title: heading, body: text });
+        } else if ('Notification' in window && Notification.permission === 'granted') {
+          new Notification(heading, { body: text });
+        } else if ('Notification' in window && Notification.permission === 'default') {
+          Notification.requestPermission().catch(() => {});
+        }
+      } catch (_) {}
+    }
+    if (!reminderSettings.speak_first || event.late) playChime();
+    if (!remindersPanel.hidden) loadReminders();
+  }
+
+  async function localSpeak(event) {
+    // Last-resort voice when no Gemini session can announce the event.
+    let granted = false;
+    try { granted = (await reminderApi('/api/reminders/events/' + event.id + '/speech')).granted === true; } catch (_) {}
+    if (!granted || !('speechSynthesis' in window)) return;
+    const prefix = event.kind === 'timer' ? 'Timer: ' : 'Reminder: ';
+    const utterance = new SpeechSynthesisUtterance(prefix + String(event.title || '') + (event.note ? '. ' + String(event.note) : ''));
+    window.speechSynthesis.speak(utterance);
+  }
+
+  async function startPlaybackOnly() {
+    playbackAudioContext = new AudioContext();
+    await playbackAudioContext.resume();
+    if (playbackAudioContext.state !== 'running') throw new Error('Audio playback is blocked until you interact with the page.');
+  }
+
+  function clearWakeCloseTimer() {
+    if (wakeCloseTimer !== null) { clearTimeout(wakeCloseTimer); wakeCloseTimer = null; }
+  }
+
+  async function endWakeSession() {
+    clearWakeCloseTimer();
+    wakeSession = false;
+    const socket = ws;
+    if (!socket || socket.readyState >= WebSocket.CLOSING) return;
+    const closed = new Promise((resolve) => socket.addEventListener('close', resolve, { once: true }));
+    await disconnect();
+    await Promise.race([closed, new Promise((resolve) => setTimeout(resolve, 2000))]);
+    await new Promise((resolve) => setTimeout(resolve, 100));
+  }
+
+  function startWakeSession() {
+    if (wakeSession || isConnecting || (ws && ws.readyState <= WebSocket.OPEN)) return;
+    wakeStartedAt = Date.now();
+    connect({ wake: true });
+  }
+
+  async function pollReminders() {
+    if (reminderPollBusy) return;
+    reminderPollBusy = true;
+    try {
+      const response = await fetch('/api/reminders/events', { cache: 'no-store' });
+      if (!response.ok) return;
+      const data = await response.json();
+      reminderSettings = Object.assign(reminderSettings, data.settings || {});
+      const events = Array.isArray(data.events) ? data.events : [];
+      for (const event of events) if (!event.shown) showReminderToast(event);
+      const waiting = events.filter((event) => !event.spoken && !event.late);
+      if (!reminderSettings.speak_first || !waiting.length) return;
+      const sessionOpen = ws && ws.readyState === WebSocket.OPEN;
+      if (sessionOpen && !wakeSession) return;                    // the backend announces it in the live session
+      if (isConnecting && !wakeSession) return;                    // the user is starting a normal session
+      if (wakeSession) {
+        if (Date.now() - wakeStartedAt > WAKE_FALLBACK_MS) {
+          for (const event of waiting) await localSpeak(event);
+          endWakeSession();
+        }
+        return;
+      }
+      if ((data.liveSessions || 0) > 0) return;                    // another Ozzy client is connected and will speak
+      if (Date.now() < wakeCooldownUntil) {
+        for (const event of waiting) await localSpeak(event);
+        return;
+      }
+      startWakeSession();
+    } catch (_) {
+      // Backend may be restarting; try again on the next poll.
+    } finally {
+      reminderPollBusy = false;
+    }
+  }
+
+  async function loadReminders() {
+    remindersList.replaceChildren();
+    try {
+      const response = await fetch('/api/reminders', { cache: 'no-store' });
+      const data = await response.json();
+      if (!response.ok) throw new Error(data.error || 'Could not load reminders');
+      reminderSettings = Object.assign(reminderSettings, data.settings || {});
+      speakFirstToggle.checked = Boolean(reminderSettings.speak_first);
+      notificationsToggle.checked = Boolean(reminderSettings.notifications);
+      const now = data.now || {};
+      remindersClock.textContent = "Ozzy's clock: " + (now.date || '') + ' · ' + (now.time_12h || '') + ' (' + (now.timezone || '') + ', UTC' + (now.utc_offset || '') + ')';
+      const reminders = Array.isArray(data.reminders) ? data.reminders : [];
+      if (!reminders.length) {
+        const empty = document.createElement('div');
+        empty.className = 'memory-empty';
+        empty.textContent = 'Nothing scheduled. Try “remind me in 20 minutes to stretch”.';
+        remindersList.appendChild(empty);
+        return;
+      }
+      for (const reminder of reminders) {
