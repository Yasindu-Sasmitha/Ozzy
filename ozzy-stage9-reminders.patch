+        self.assertIn("CURRENT CLOCK", text)
+        self.assertIn("STAGE 9", text)
+        self.assertIn("PERSONALITY", text)
+        validated = types.LiveConnectConfig.model_validate(config)
+        self.assertTrue(validated.tools)
